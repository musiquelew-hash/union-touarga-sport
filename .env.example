# Local and Railway HTTP port.
PORT=8080

# Local XAMPP/MariaDB. Replace this URL with Railway's MYSQL_URL in production.
MYSQL_URL=mysql://root:@127.0.0.1:3306/uts_site

# Single administrator account.
ADMIN_USERNAME=admin
# Use at least 12 characters.
ADMIN_PASSWORD=replace-with-a-long-password
# Use at least 32 random characters and do not reuse the password.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters