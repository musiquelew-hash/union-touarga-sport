# Local and Railway HTTP port.
PORT=8080

# Local XAMPP/MariaDB. Replace this URL with Railway's MYSQL_URL in production.
MYSQL_URL=mysql://root:@127.0.0.1:3306/uts_site

# The SQL migration creates or restores the initial super-administrator once.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Super administrateur
# Optional fallback used only if SQL provisioning did not create an account. Use at least 12 characters.
ADMIN_PASSWORD=replace-with-a-long-password
# Signs all dashboard sessions. Keep this stable and use at least 32 random characters.
